{
  "name": "coolmaths-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server that serves the coolmaths games, their maths and their runnable logic as grounded tutoring material.",
  "type": "module",
  "scripts": {
    "build-index": "node scripts/build-index.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build-index && wrangler dev",
    "deploy": "npm run build-index && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
